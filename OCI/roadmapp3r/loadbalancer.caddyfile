roadmapper-staging.intcube.dev:80 {
    @blocked not client_ip 77.245.43.68 10.0.0.0/8
    respond @blocked "Access Denied" 403

    reverse_proxy localhost:4000 {
        header_up X-Real-IP {http.request.remote.host}
    }
}

roadmapper.int3.app:80 int3.app:80 {
    reverse_proxy localhost:4000 {
        header_up X-Real-IP {http.request.remote.host}
    }
}
